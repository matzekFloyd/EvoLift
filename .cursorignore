android/**/res/**/*.webp
android/**/res/**/*.jpg
android/**/res/**/*.jpeg

# Tooling dumps
**/*.tsbuildinfo
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Secrets / env
.env*
*.pem